# --- Warcraft Logs ---
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# --- Postgres (ports décalés, cf. docker-compose.yml) ---
DATABASE_URL=postgresql://timeline:timeline@localhost:55432/timeline

# --- Redis ---
REDIS_URL=redis://localhost:56379

# --- API ---
API_PORT=3000

# --- Déploiement (Vercel) — vides en local ---
# Jeton de l'admin (/api/admin). Absent une fois déployé = admin fermé.
ADMIN_TOKEN=
# Fourni par Vercel aux appels de cron ; protège /api/cron/purge.
CRON_SECRET=
# Au-delà de ce nombre de runs, le cron supprime la moitié la plus ancienne.
PURGE_MAX_RUNS=27000

# --- Mode ---
# DEV : outils de développement (scans forcés, tiroir d'historique). Vide = production :
# ne JAMAIS le mettre à DEV sur Vercel.
APP_MODE=
