# Credentials OAuth — https://www.warcraftlogs.com/api/clients/
# Copier vers recon/.env (non versionné) et remplir.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Redirect URI à déclarer sur le client OAuth, pour l'étape 06 uniquement.
WCL_REDIRECT_URI=http://localhost:4477/callback

# Log M+ témoin : URL complète ou code de rapport (16 caractères).
WCL_TEST_REPORT=

# Zone de la saison M+ courante — à remplir après avoir lancé l'étape 00.
WCL_ZONE_ID=
